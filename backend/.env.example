# ==============================================================================
# NEXSURE ENTERPRISE AI ENGINE -- ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env for local overrides. In Render/Vercel, configure these
# variables inside the service Environment settings.
# All variables have safe production defaults if omitted.
# ==============================================================================

# Application Runtime Environment (production | development | staging)
ENVIRONMENT=production

# Public URL of the deployed FastAPI Backend (Render)
APP_URL=https://nexsure-backend.onrender.com

# Public URL of the deployed Frontend (Vercel)
FRONTEND_URL=https://nexsure.vercel.app

# Allowed CORS Origins (comma-separated list)
# Example: http://localhost:3000,http://localhost:5173,https://nexsure.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,https://nexsure.vercel.app

# Optional Custom Path Overrides (Default: auto-detected relative to repository root)
# MODEL_DIR=./model
# DATA_DIR=./backend/data
# BASE_DIR=.

# Server Network Configuration (Render automatically sets PORT)
PORT=8000
HOST=0.0.0.0

# Logging Mode & Verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# OpenMP & Thread Pool Optimization
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
