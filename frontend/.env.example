# ==============================================================================
# NEXSURE FRONTEND ENVIRONMENT CONFIGURATION (NEXT.JS)
# ==============================================================================

# Backend API Endpoint (FastAPI deployed on Render or localhost)
# Local: http://127.0.0.1:8000
# Production: https://<your-backend-app>.onrender.com
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Frontend Public Application URL (Vercel domain or localhost)
# Local: http://localhost:3000
# Production: https://<your-frontend-app>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000
